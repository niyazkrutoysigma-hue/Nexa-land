<Window x:Class="MinecraftLauncher.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод значения"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Base}"
        ShowInTaskbar="False">

    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBox x:Name="InputBox" Style="{StaticResource AppTextBox}"
                 KeyDown="OnKeyDown" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" IsCancel="True" />
            <Button Content="ОК" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                    IsDefault="True" Click="OnOk" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
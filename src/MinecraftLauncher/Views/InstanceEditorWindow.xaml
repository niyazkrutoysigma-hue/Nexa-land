<Window x:Class="MinecraftLauncher.Views.InstanceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InstanceEditorViewModel}"
        Title="{Binding IsEdit, Converter={StaticResource EditTitleConverter}}"
        Width="760" Height="620" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Bg.Base}"
        UseLayoutRounding="True"
        Loaded="OnLoaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding IsEdit, Converter={StaticResource EditorHeaderConverter}}"
                       Style="{StaticResource H1}" />
            <TextBlock Text="Файлы скачиваются автоматически при первом запуске" Style="{StaticResource Caption}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Название -->
                <TextBlock Text="Название" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Версия Minecraft -->
                <TextBlock Text="Версия Minecraft" Style="{StaticResource Caption}" Margin="0,16,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр по номеру версии" KeyDown="OnFilterKeyDown"
                             Tag="{Binding}" />

                    <CheckBox Grid.Column="1" Content="Снапшоты" Style="{StaticResource AppCheckBox}"
                              Margin="12,0,0,0" IsChecked="{Binding ShowSnapshots}" VerticalAlignment="Center" />
                </Grid>

                <ComboBox Style="{StaticResource AppComboBox}" Margin="0,8,0,0" MaxHeight="220"
                          ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                          DisplayMemberPath="Id" ItemContainerStyle="{StaticResource AppComboBoxItem}"
                          VirtualizingPanel.IsVirtualizing="True" />

                <!-- Загрузчик -->
                <TextBlock Text="Загрузчик модов" Style="{StaticResource Caption}" Margin="0,16,0,5" />
                <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Loaders}"
                          SelectedItem="{Binding SelectedLoader}" ItemContainerStyle="{StaticResource AppComboBoxItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LoaderName}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{Binding LoaderHint}" Style="{StaticResource Caption}" Margin="2,6,0,0" />

                <Grid Margin="0,8,0,0" Visibility="{Binding SelectedLoader, Converter={StaticResource NotVanilla}, ConverterParameter=None}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Style="{StaticResource AppComboBox}"
                              ItemsSource="{Binding LoaderVersions}"
                              SelectedValuePath="Version" SelectedValue="{Binding LoaderVersion}"
                              DisplayMemberPath="Name" ItemContainerStyle="{StaticResource AppComboBoxItem}"
                              IsEditable="True" ToolTip="Список с сервера или введите вручную" />

                    <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Width="180" Margin="8,0,0,0"
                             Text="{Binding LoaderVersion, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Память -->
                <TextBlock Text="Выделить памяти" Style="{StaticResource Caption}" Margin="0,16,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0" Style="{StaticResource AppSlider}" Minimum="1024" Maximum="{Binding MaxRam}"
                            TickFrequency="1024" IsSnapToTickEnabled="True" Value="{Binding Ram, Mode=TwoWay}" />

                    <TextBlock Grid.Column="1" Text="{Binding RamText}" MinWidth="80" TextAlignment="Right"
                               VerticalAlignment="Center" FontFamily="Segoe UI Semibold" />
                </Grid>

                <!-- Java -->
                <TextBlock Text="Путь к Java (пусто — подобрать автоматически)" Style="{StaticResource Caption}"
                           Margin="0,16,0,5" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Свои библиотеки и версии (полная изоляция)"
                          Style="{StaticResource AppCheckBox}" Margin="0,14,0,0" IsChecked="{Binding Isolated}" />

                <!-- Аргументы -->
                <TextBlock Text="Доп. аргументы JVM" Style="{StaticResource Caption}" Margin="0,16,0,5" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding JavaArgs, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Например: -XX:+UseZGC -Dfile.encoding=UTF-8" />

                <TextBlock Text="Доп. аргументы игры" Style="{StaticResource Caption}" Margin="0,14,0,5" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding MinecraftArgs, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Например: --width 1600 --height 900" />
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" />
            <Button Content="Создать" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                    Command="{Binding SaveCommand}" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
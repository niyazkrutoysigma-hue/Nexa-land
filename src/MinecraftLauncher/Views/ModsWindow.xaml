<Window x:Class="MinecraftLauncher.Views.ModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ModsManagerViewModel}"
        Title="NEXA LAND — Моды сборки"
        Width="1180" Height="780" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Источник-вкладка -->
        <Style x:Key="SourceTab" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" CornerRadius="9" Padding="16,9" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg.Secondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Bg.Elev2}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Accent.Base}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Категория-чип -->
        <Style x:Key="CategoryChip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="14" Padding="14,7"
                                Background="{DynamicResource Bg.Elev2}"
                                BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Accent.Base}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent.Base}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                             Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Карточка мода -->
        <Style x:Key="ModCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Elev1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11" />
            <Setter Property="Width" Value="214" />
            <Setter Property="Height" Value="238" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Border}" />
                    <Setter Property="Background" Value="{DynamicResource Bg.Elev2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Шапка ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0"
                    Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Border}"
                    BorderThickness="1">
                <Path Stretch="Uniform" Margin="9" Stroke="{DynamicResource Accent.Base}" StrokeThickness="2.2"
                      StrokeLineJoin="Round"
                      Data="M12,1 L23,12 L12,23 L1,12 Z M12,6.5 L17.5,12 L12,17.5 L6.5,12 Z" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Дополнения сборки" Style="{StaticResource H1}" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding InstanceTitle}" Style="{StaticResource Body}" />
                    <TextBlock Text=" · " Style="{StaticResource Body}" />
                    <TextBlock Text="{Binding InstalledCountText}" Style="{StaticResource Body}"
                               Foreground="{DynamicResource Accent.Base}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Папка mods" Style="{StaticResource GhostButton}"
                        Command="{Binding OpenModsFolderCommand}" ToolTip="Открыть папку модов сборки" />
                <Button Content="Импорт .mrpack" Style="{StaticResource GhostButton}"
                        Command="{Binding ImportPackCommand}" ToolTip="Установить модпак Modrinth" />
                <Button Content="Экспорт" Style="{StaticResource GhostButton}"
                        Command="{Binding ExportPackCommand}" ToolTip="Собрать модпак из текущих модов" />
                <Button Content="Обновить всё" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                        Command="{Binding CheckUpdatesCommand}" ToolTip="Проверить обновления модов" />
                <Button Content="✕" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                        Click="OnCloseClick" FontSize="15" ToolTip="Закрыть" />
            </StackPanel>
        </Grid>

        <!-- ================= Источники + поиск ================= -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource SourceTab}" GroupName="Source" Content="Установленные"
                             Command="{Binding SourceCommand}" CommandParameter="installed"
                             IsChecked="{Binding IsInstalledTab, Mode=OneWay}" />
                <RadioButton Style="{StaticResource SourceTab}" GroupName="Source" Content="Modrinth"
                             Command="{Binding SourceCommand}" CommandParameter="modrinth"
                             IsChecked="{Binding IsModrinthTab, Mode=OneWay}" />
                <RadioButton Style="{StaticResource SourceTab}" GroupName="Source" Content="CurseForge"
                             Command="{Binding SourceCommand}" CommandParameter="curseforge"
                             IsChecked="{Binding IsCurseForgeTab, Mode=OneWay}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                <TextBox Style="{StaticResource AppTextBox}" MaxWidth="380" Width="380"
                         HorizontalAlignment="Left"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown" />
                <TextBlock Text="Поиск модов… (Enter)" IsHitTestVisible="False" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Fg.Muted}" FontSize="13"
                           Visibility="{Binding Search, Converter={StaticResource EmptyStringVis}}" />
            </Grid>

            <ComboBox Grid.Column="2" Style="{StaticResource AppComboBox}" Width="190"
                      ItemsSource="{Binding Sorts}" SelectedValuePath="Key"
                      SelectedValue="{Binding Sort}"
                      ItemContainerStyle="{StaticResource AppComboBoxItem}"
                      Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ================= Категории ================= -->
        <ListBox Grid.Row="2" Margin="0,14,0,12" MaxHeight="94"
                 ItemsSource="{Binding AllCategories}" SelectedItem="{Binding Category}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource CategoryChip}"
                 Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CategoryText}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ================= Содержимое ================= -->
        <Grid Grid.Row="3">

            <!-- Установленные моды -->
            <Grid Visibility="{Binding IsInstalledTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding InstalledMods}" SelectedItem="{Binding SelectedInstalled}"
                         Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Bg.Elev1}" CornerRadius="10" Padding="12,10"
                                    BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                       FontFamily="Segoe UI Semibold" />
                                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                    Background="{DynamicResource Accent.Soft}">
                                                <TextBlock Text="{Binding SourceText}" FontSize="10.5"
                                                           Foreground="{DynamicResource Fg.Primary}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" />
                                            <TextBlock Text=" · " Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" />
                                            <TextBlock Text=" · " Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="⏻" Style="{StaticResource GhostButton}"
                                                Tag="{Binding}" Click="OnToggleClick" ToolTip="Включить / выключить" />
                                        <Button Content="🗑" Style="{StaticResource GhostButton}"
                                                Tag="{Binding}" Click="OnRemoveClick" ToolTip="Удалить" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding NoInstalledText}" Style="{StaticResource Body}" MaxWidth="580"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding InstalledCount, Converter={StaticResource CountToVis}}" />
            </Grid>

            <!-- Каталог модов -->
            <Grid Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="12,9" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalText}" FontSize="12.5"
                                       Foreground="{DynamicResource Fg.Primary}" />
                            <TextBlock Text=" · " Style="{StaticResource Body}" />
                            <TextBlock Text="{Binding LoadedText}" Style="{StaticResource Caption}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsCurseForgeTab, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding CurseForgeHint}" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource Status.Warn}" VerticalAlignment="Center" />
                <Button Content="Получить ключ" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="OnGetCurseForgeKeyClick" ToolTip="Открыть console.curseforge.com" />
            </StackPanel>
                            <Button Content="Сбросить" Style="{StaticResource GhostButton}"
                                    Command="{Binding ResetCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnCatalogScroll">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Catalog}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Обложка -->
                                            <Border Grid.Row="0" Height="78" CornerRadius="9"
                                                    Background="{DynamicResource Bg.Sunken}" ClipToBounds="True">
                                                <Grid>
                                                    <!-- заглушка: ромбик бренда -->
                                                    <Path Stretch="Uniform" Margin="26" Opacity="0.5"
                                                          Stroke="{DynamicResource Fg.Muted}" StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          Data="M12,1 L23,12 L12,23 L1,12 Z" />

                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                           Margin="7" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="2,10,2,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           FontFamily="Segoe UI Semibold" TextWrapping="Wrap"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{DynamicResource Fg.Muted}"
                                                           TextWrapping="Wrap" MaxHeight="32"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding Downloads}" Style="{StaticResource Caption}"
                                                           Margin="2,0,0,6" />
                                                <Button Content="{Binding State}" Tag="{Binding}"
                                                        Click="OnModActionClick" MinHeight="32" FontSize="12"
                                                        Style="{StaticResource AccentButton}" />
                                                <ProgressBar Style="{StaticResource AppProgressBar}"
                                                             IsIndeterminate="True" Margin="0,6,0,0"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding CatalogCount, Converter={StaticResource CountToVis}}">
                <TextBlock Text="Ничего не найдено" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                <TextBlock Text="Попробуйте другой запрос или выберите категорию «Все»" Style="{StaticResource Body}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Button Content="Загрузить ещё 100 модов" Style="{StaticResource OutlineButton}"
                            Padding="20,10" Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= Подвал ================= -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Fg.Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ModsFolder}" FontSize="11" Foreground="{DynamicResource Fg.Muted}"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                       MaxWidth="620" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
<UserControl x:Class="MinecraftLauncher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MinecraftLauncher.Converters"
             xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccountsViewModel}">

    <UserControl.Resources>
        <conv:FileImageConverter x:Key="FileImage" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="250" />
            <ColumnDefinition Width="3*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Список аккаунтов -->
        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Войти через Microsoft" Style="{StaticResource AccentButton}"
                        Command="{Binding AddMicrosoftCommand}" />
                <Button Content="Оффлайн-профиль" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                        Command="{Binding AddOfflineCommand}" />
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}"
                     Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                     Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg.Elev1}" BorderBrush="{DynamicResource Stroke.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,11,0">
                                    <Border CornerRadius="17" Background="{DynamicResource Bg.Elev2}" />
                                    <TextBlock Text="{Binding DisplayName, StringFormat={}{0[0]}}"
                                               FontFamily="Segoe UI Black" FontSize="14"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="34" Height="34" Fill="{DynamicResource Bg.Hover}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5"
                                               FontFamily="Segoe UI Semibold" />
                                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Caption}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="активен" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Accent.Base}"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource Body}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       MaxWidth="320"
                       Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>

        <!-- Детали + вход -->
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Вход в аккаунт Microsoft" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0">
                    <Run Text="1. Нажмите «Войти через Microsoft» — откроется страница авторизации." />
                    <LineBreak />
                    <Run Text="2. Введите код, который покажет лаунчер." />
                    <LineBreak />
                    <Run Text="3. Аккаунт должен Own'ить Minecraft: Java Edition или иметь Game Pass." />
                </TextBlock>

                <!-- Код подтверждения -->
                <Border Style="{StaticResource Panel}" Padding="14" Margin="0,14,0,0"
                        Visibility="{Binding HasDeviceCode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="КОД ПОДТВЕРЖДЕНИЯ" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="24"
                                   FontWeight="Bold" Foreground="{DynamicResource Accent.Base}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DeviceUrl}" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Скопировать код" Style="{StaticResource OutlineButton}"
                                    Command="{Binding CopyCodeCommand}" />
                            <Button Content="Открыть страницу" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Command="{Binding OpenBrowserCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" Margin="0,14,0,0" />

                <!-- Действия над выбранным аккаунтом -->
                <StackPanel Margin="0,16,0,0" DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding DisplayName, StringFormat=Выбран: {0}}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding LastError, StringFormat=Ошибка: {0}}"
                               Foreground="{DynamicResource Status.Err}" Style="{StaticResource Body}"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding LastError, Converter={StaticResource StringVis}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Сделать активным" Style="{StaticResource AccentButton}"
                                Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="Обновить токен" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                                Command="{Binding DataContext.RefreshTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
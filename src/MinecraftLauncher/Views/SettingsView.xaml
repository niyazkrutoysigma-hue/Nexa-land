<UserControl x:Class="MinecraftLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,12,0">

            <!-- ================= Память ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Память для игры" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding TotalRamText}" Style="{StaticResource Caption}" Margin="0,2,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Slider Grid.Column="0" Style="{StaticResource AppSlider}" Minimum="1024" Maximum="{Binding MaxRam}"
                                TickFrequency="1024" IsSnapToTickEnabled="True"
                                Value="{Binding Ram, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1" Text="{Binding RamText}" MinWidth="130" TextAlignment="Right"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Semibold" />
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0">
                        <Run Text="Для Fabric/Forge с большими сборками модулей обычно нужно 4–8 ГБ." />
                        <LineBreak />
                        <Run Text="Значение по умолчанию применяется к новым инстансам; у каждого инстанса своё значение." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ================= Java ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Java" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding JavaSummary}" Style="{StaticResource Caption}" Margin="0,2,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                                 Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Путь к папке JDK/JRE. Пусто — искать автоматически" />

                        <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                                Command="{Binding PickJavaCommand}" />
                        <Button Grid.Column="2" Content="Найти" Style="{StaticResource GhostButton}"
                                Command="{Binding AutoDetectJavaCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding JavaList}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,1" Text="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Content="Скачивать Java автоматически, если нужная версия не найдена"
                              Style="{StaticResource AppCheckBox}" Margin="0,12,0,0"
                              IsChecked="{Binding AutoInstallJava}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Скачать Temurin 21" Style="{StaticResource OutlineButton}"
                                Command="{Binding InstallJavaCommand}" />
                        <TextBlock Text="нужна для Minecraft 1.20.5+ и всех 1.21" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= Оформление ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Оформление" Style="{StaticResource H2}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton Content="Тёмная" Style="{StaticResource AppRadio}" Margin="0,0,20,0" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource ThemeRadio}, ConverterParameter=Dark}" />
                        <RadioButton Content="Светлая" Style="{StaticResource AppRadio}" GroupName="Theme"
                                     IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource ThemeRadio}, ConverterParameter=Light}" />
                    </StackPanel>

                    <TextBlock Text="Акцентный цвет" Style="{StaticResource H2}" Margin="0,16,0,8" />
                    <ItemsControl ItemsSource="{Binding Accents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,10,10" Width="72">
                                    <Button Height="34" Width="72" Tag="{Binding Hex}" Click="OnAccentClick"
                                            Background="{Binding Hex}" BorderThickness="0"
                                            ToolTip="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}" MaxWidth="200" Width="200"
                                 HorizontalAlignment="Left" Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Свой HEX-цвет, например #4C8DFF" />

                        <Button Grid.Column="1" Content="Применить" Style="{StaticResource GhostButton}"
                                Command="{Binding ApplyAccentCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= Папки и поведение ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Папки и поведение" Style="{StaticResource H2}" />

                    <TextBlock Text="Папка инстансов" Style="{StaticResource Caption}" Margin="0,12,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                                 Text="{Binding InstancesFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Пусто — использовать папку в %AppData%" />

                        <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                                Command="{Binding PickInstancesFolderCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding InstancesFolderInfo}" Style="{StaticResource Caption}" Margin="2,6,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <CheckBox Content="Закрывать лаунчер после запуска игры" Style="{StaticResource AppCheckBox}"
                              Margin="0,16,0,0" IsChecked="{Binding CloseAfterLaunch}" />

                    <CheckBox Content="Проверять обновления лаунчера при запуске" Style="{StaticResource AppCheckBox}"
                              Margin="0,10,0,0" IsChecked="{Binding AutoUpdateLauncher}" />

                    <TextBlock Text="Имя лаунчера (видно в логах игры)" Style="{StaticResource Caption}"
                               Margin="0,16,0,5" />
                    <TextBox Style="{StaticResource AppTextBox}" MaxWidth="320" Width="320"
                             HorizontalAlignment="Left" Text="{Binding LauncherBrand, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Папка данных" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="Логи" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Command="{Binding OpenLogsCommand}" />
                        <Button Content="Очистить кэш" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Command="{Binding ClearCacheCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= API и обновления ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Интеграции" Style="{StaticResource H2}" />

                    <TextBlock Text="GitHub-репозиторий для автообновления (owner/name)"
                               Style="{StaticResource Caption}" Margin="0,12,0,5" />
                    <TextBox Style="{StaticResource AppTextBox}" MaxWidth="420" Width="420"
                             HorizontalAlignment="Left"
                             Text="{Binding SelfUpdateRepo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Берётся последний релиз через GitHub API" />

                    <TextBlock Text="CurseForge API key (необязательно)" Style="{StaticResource Caption}"
                               Margin="0,16,0,5" />
                    <TextBox Style="{StaticResource AppTextBox}" MaxWidth="420" Width="420"
                             HorizontalAlignment="Left"
                             Text="{Binding CurseForgeApiKey, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap">
                        <Run Text="Данные лаунчера: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>

                    <Button Content="Сохранить настройки" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
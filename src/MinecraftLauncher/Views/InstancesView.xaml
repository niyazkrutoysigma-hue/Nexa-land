<UserControl x:Class="MinecraftLauncher.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MinecraftLauncher.Converters"
             xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstancesViewModel}">

    <UserControl.Resources>
        <conv:FileImageConverter x:Key="FileImage" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Left" Width="260">
                <TextBox Style="{StaticResource AppTextBox}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Поиск по названию, версии или загрузчику" />
                <TextBlock Text="Поиск сборки…" IsHitTestVisible="False" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource Fg.Muted}"
                           Visibility="{Binding Search, Converter={StaticResource EmptyStringVis}}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Обновить" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                <Button Content="+ Создать сборку" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Command="{Binding NewCommand}" />
            </StackPanel>
        </Grid>

        <!-- Список инстансов -->
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}"
                     Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                     Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg.Elev1}" BorderBrush="{DynamicResource Stroke.Default}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Иконка -->
                                <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,14,0">
                                    <Border CornerRadius="10" Background="{DynamicResource Bg.Elev2}">
                                        <TextBlock Text="{Binding Name, StringFormat={}{0[0]}}"
                                                   FontFamily="Segoe UI Black" FontSize="18"
                                                   Foreground="{DynamicResource Fg.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding IconFile, Converter={StaticResource FileImage}}"
                                           Width="46" Height="46" Stretch="UniformToFill" />
                                </Grid>

                                <!-- Информация -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="14.5"
                                                   Foreground="{DynamicResource Fg.Primary}" />
                                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                                Visibility="{Binding Loader, Converter={StaticResource NotVanilla}, ConverterParameter=None}">
                                            <TextBlock Text="{Binding LoaderName}" FontSize="11"
                                                       Foreground="{DynamicResource Fg.Primary}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource Body}"
                                               Margin="0,3,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding FolderInfo}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="6,0" />
                                        <TextBlock Text="{Binding EnabledModsCount, StringFormat={}{0} модов}"
                                                   Style="{StaticResource Caption}" />
                                        <TextBlock Text="· RAM " Style="{StaticResource Caption}" Margin="6,0" />
                                        <TextBlock Text="{Binding RamMb, StringFormat={}{0} МБ}"
                                                   Style="{StaticResource Caption}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource Status.Err}"
                                               FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding LastError, Converter={StaticResource StringVis}}" />
                                </StackPanel>

                                <!-- Кнопки -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Играть" Style="{StaticResource AccentButton}"
                                            Tag="{Binding}" Click="OnLaunchClick" MinWidth="86" />
                                    <Button Content="+" Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                                            FontSize="16" Padding="11,4" Tag="{Binding}" Click="OnModsClick"
                                            ToolTip="Дополнения: моды Modrinth и CurseForge" />
                                    <Button Content="⋯" Style="{StaticResource GhostButton}" Margin="2,0,0,0"
                                            FontSize="15" Tag="{Binding}" Click="OnMenuClick"
                                            ToolTip="Другие действия" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Пустое состояние -->
            <Border Visibility="{Binding HasInstances, Converter={StaticResource InverseBoolToVis}}"
                    Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="420">
                <StackPanel>
                    <TextBlock Text="Пока нет инстансов" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,8,0,14" TextAlignment="Center" />
                    <Button Content="Создать первый инстанс" Style="{StaticResource AccentButton}"
                            Command="{Binding NewCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
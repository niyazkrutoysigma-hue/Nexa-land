<UserControl x:Class="MinecraftLauncher.Views.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminPanelViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Форма ввода пароля (если не авторизован) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}">
            <Border Width="64" Height="64" CornerRadius="16" Margin="0,0,0,24"
                    Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Border}" BorderThickness="1"
                    HorizontalAlignment="Center">
                <Path Stretch="Uniform" Margin="16" Stroke="{DynamicResource Accent.Base}" StrokeThickness="2.2"
                      StrokeLineJoin="Round" Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </Border>
            <TextBlock Text="Админ-панель" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Введите пароль администратора" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,0,0,24" />

            <Border Style="{StaticResource Card}" Padding="28">
                <StackPanel>
                    <TextBlock Text="Пароль" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox" Height="36" Padding="12,0" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Status.Err}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Button Content="Войти" Style="{StaticResource AccentButton}" Padding="0,12" FontSize="14"
                            Click="OnLoginClick" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Панель администратора (после авторизации) -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                <TextBlock Text="Админ-панель" Style="{StaticResource H1}" Margin="0,0,0,8" />
                <TextBlock Text="Управление пользователями и настройками" Style="{StaticResource Body}" Margin="0,0,0,24" />

                <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📊 Статистика" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <TextBlock Text="Админ-панель работает. Управление пользователями через Telegram-бота." Style="{StaticResource Body}" />
                        <TextBlock Text="Команды бота: /give_orbs email количество, /give_premium email дни" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="🔧 Быстрые действия" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <Button Content="Открыть Telegram-бота" Style="{StaticResource AccentButton}" Padding="16,10" FontSize="13"
                                Click="OnOpenBotClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
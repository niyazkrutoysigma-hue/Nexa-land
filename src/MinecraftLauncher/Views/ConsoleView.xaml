<UserControl x:Class="MinecraftLauncher.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MinecraftLauncher.Converters"
             xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConsoleViewModel}">

    <UserControl.Resources>
        <conv:LogLevelToBrushConverter x:Key="LevelBrush" />
        <conv:LogLevelToNameConverter x:Key="LevelName" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}" MaxWidth="300" Width="260"
                     HorizontalAlignment="Left" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Фильтр по тексту или уровню (Info, Warn, Error)" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox Content="Автопрокрутка" Style="{StaticResource AppCheckBox}" IsChecked="{Binding AutoScroll}"
                          VerticalAlignment="Center" />
                <Button Content="Копировать" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                        Command="{Binding CopyCommand}" />
                <Button Content="Папка логов" Style="{StaticResource GhostButton}"
                        Command="{Binding OpenLogsCommand}" />
                <Button Content="Очистить" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Bg.Sunken}" CornerRadius="8"
                BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1">
            <ListBox x:Name="LogList" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11.5"
                                       Foreground="{DynamicResource Fg.Muted}" Margin="0,0,10,0" />

                            <TextBlock Grid.Column="1" Text="{Binding Level, Converter={StaticResource LevelName}}"
                                       FontFamily="Consolas" FontSize="11.5" Width="62"
                                       Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />

                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas" FontSize="11.5"
                                       Foreground="{DynamicResource Fg.Primary}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
<Window x:Class="MinecraftLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
        xmlns:common="clr-namespace:MinecraftLauncher.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NEXA LAND"
        Height="800" Width="1280" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CheckUpdatesCommand}" />
        <KeyBinding Key="F6" Command="{Binding RefreshAllCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Боковое меню ============ -->
        <Border Grid.Column="0" Background="{DynamicResource Bg.Elev1}"
                BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Логотип-ромбик -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,20">
                    <Border Width="38" Height="38" CornerRadius="11"
                            Background="{DynamicResource Accent.Soft}"
                            BorderBrush="{DynamicResource Accent.Border}" BorderThickness="1">
                        <Path Stretch="Uniform" Margin="8" Stroke="{DynamicResource Accent.Base}"
                              StrokeThickness="2.2" StrokeLineJoin="Round"
                              Data="M12,1 L23,12 L12,23 L1,12 Z M12,6.5 L17.5,12 L12,17.5 L6.5,12 Z" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BrandTitle}" FontFamily="Segoe UI Black" FontSize="15"
                                   Foreground="{DynamicResource Fg.Primary}" />
                        <TextBlock Text="{Binding BrandTagline}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Навигация -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Data="{Binding Icon}" Stroke="{DynamicResource Fg.Secondary}"
                                      StrokeThickness="1.5" Stretch="Uniform" Width="17" Height="17"
                                      VerticalAlignment="Center" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           FontSize="13.5" Foreground="{DynamicResource Fg.Primary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Активный аккаунт -->
                <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="АКТИВНЫЙ АККАУНТ" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ActiveAccountText}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{DynamicResource Fg.Primary}" />
                        <TextBlock Text="{Binding UpdateInfo}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Основная область ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <StackPanel Grid.Row="0" Margin="26,20,26,10">
                <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding SelectedPage.Subtitle}" Style="{StaticResource Body}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Содержимое страницы -->
            <ContentControl Grid.Row="1" Margin="26,4,26,10" Content="{Binding SelectedPage.Content}" />

            <!-- ============ Всплывающие уведомления ============ -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,26,0"
                          Panel.ZIndex="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,10"
                                MaxWidth="360" BorderBrush="{DynamicResource Accent.Border}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black" />
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Level, Converter={StaticResource ToastBrush}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <Button Content="{Binding ActionText}" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Margin="-8,4,0,0" Padding="8,4"
                                            Click="OnToastActionClick" Tag="{Binding}"
                                            Visibility="{Binding WithAction, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                                        Padding="6,2" FontSize="12" Tag="{Binding}"
                                        Click="OnToastCloseClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Статус-бар ============ -->
            <Border Grid.Row="2" Background="{DynamicResource Bg.Elev1}"
                    BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="0,1,0,0">
                <Grid Margin="26,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Fg.Secondary}" />
                        <ProgressBar Style="{StaticResource AppProgressBar}" Margin="0,6,0,0"
                                     Maximum="1" Value="{Binding Progress}" Visibility="{Binding Progress}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Status.Ok}" Margin="0,0,8,0" />
                        <TextBlock Text="Онлайн" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Button Content="Обновить" Style="{StaticResource GhostButton}" Margin="14,0,0,0"
                                Command="{Binding CheckUpdatesCommand}" ToolTip="Проверить обновления (F5)" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
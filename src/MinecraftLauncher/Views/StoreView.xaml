<UserControl x:Class="MinecraftLauncher.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StoreViewModel}"
             Loaded="OnLoaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="250" />
            <ColumnDefinition Width="3*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- Список версий -->
        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр по номеру версии" />

                    <CheckBox Grid.Column="1" Content="Снапшоты" Style="{StaticResource AppCheckBox}"
                              Margin="12,0,0,0" IsChecked="{Binding ShowSnapshots}" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{Binding LatestInfo}" Style="{StaticResource Caption}" Margin="2,8,0,0" />
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}"
                     Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg.Elev1}" BorderBrush="{DynamicResource Stroke.Default}"
                                BorderThickness="1" CornerRadius="8" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}" FontFamily="Segoe UI Semibold" FontSize="13.5" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" />
                                        <TextBlock Text=" · " Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center"
                                        Background="{DynamicResource Bg.Elev2}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Fg.Secondary}"
                                               Text="{Binding RequiredJava, StringFormat=Java {0}}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Детали выбранной версии -->
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Text="{Binding Id}" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0">
                    <Run Text="Тип: " /><Run Text="{Binding Type, Mode=OneWay}" /><Run Text=" · дата: " />
                    <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text=" · нужна Java " />
                    <Run Text="{Binding RequiredJava, Mode=OneWay}" />
                </TextBlock>

                <Separator Background="{DynamicResource Stroke.Default}" Margin="0,16" />

                <TextBlock Text="Что можно сделать" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0">
                    <Run Text="«Установить» создаст ванильный инстанс и сразу скачает файлы." />
                    <LineBreak />
                    <Run Text="«Создать сборку» откроет мастер: там можно выбрать Fabric/Quilt/Forge/NeoForge, память и аргументы." />
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Установить" Style="{StaticResource AccentButton}" MinWidth="140"
                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Content="Создать сборку" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                            Command="{Binding DataContext.InstallWithLoaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
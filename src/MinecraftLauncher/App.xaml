<Application x:Class="MinecraftLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MinecraftLauncher.Converters"
             xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
             xmlns:views="clr-namespace:MinecraftLauncher.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Конвертеры -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:StringToVisibilityConverter x:Key="StringVis" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringVis" />
            <conv:LoginWidthConverter x:Key="LoginWidth" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:EnumNotEqualsConverter x:Key="NotVanilla" />
            <conv:EnumEqualsConverter x:Key="ThemeRadio" />
            <conv:ZeroCountToVisibilityConverter x:Key="CountToVis" />
            <conv:BytesToTextConverter x:Key="BytesToText" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />
            <conv:LogLevelToNameConverter x:Key="LogLevelName" />
            <conv:LoaderDisplayConverter x:Key="LoaderName" />
            <conv:ToastBrushConverter x:Key="ToastBrush" />
            <conv:EditTitleConverter x:Key="EditTitleConverter" />
            <conv:EditHeaderConverter x:Key="EditorHeaderConverter" />

            <!-- Шаблоны страниц -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
                <views:InstancesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StoreViewModel}">
                <views:StoreView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:AdminPanelViewModel}">
                <views:AdminPanelView />
            </DataTemplate>
            
            
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
                <views:AccountsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConsoleViewModel}">
                <views:ConsoleView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>